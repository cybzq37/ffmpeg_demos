{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/ffmpeg-merge.exe",
            "args": [],
            "cwd": "${workspaceFolder}/build",
            "env": {
                "PATH": "${workspaceFolder}/build;${env:PATH}"
            },
            "stopOnEntry": false,
            "console": "integratedTerminal",
